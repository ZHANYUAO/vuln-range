## pentagi → 本地统一网关（Custom LLM provider）
## 字段来源：pentagi/.env.example 第 143-154 行（非 README 推测）
## 容器内访问宿主必须用 host.docker.internal，不能用 localhost
LLM_SERVER_URL=http://host.docker.internal:8790/v1
LLM_SERVER_KEY=CHANGE_ME_GATEWAY_TOKEN
LLM_SERVER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_SERVER_PROVIDER=
LLM_SERVER_CONFIG_PATH=
## 留空 = 纯 OpenAI 兼容端点（.env.example 原文：leave it empty for a plain OpenAI-compatible endpoint）
LLM_SERVER_API_TYPE=
LLM_SERVER_API_VERSION=
